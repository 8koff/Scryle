# Copy to .env.local (never commit it). Only EXPO_PUBLIC_* values reach the app, and they are
# public by design: the site address and Supabase's publishable key (same as the web's NEXT_PUBLIC_* ones).

# The site the app calls. Leave empty for the live site (https://scryle.app).
EXPO_PUBLIC_API_URL=

# Same values as NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY in apps/web.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
