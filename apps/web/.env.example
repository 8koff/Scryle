# Higgsfield — https://console.higgsfield.ai (API keys page)
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: model for reading photos (default claude-opus-5-5)
VISION_MODEL=
# Only needed if your key was made at the organization level (not inside a workspace)
ANTHROPIC_WORKSPACE_ID=

# Optional: default swap model (marketing-low | marketing-low-2k | qwen-1k). Default marketing-low.
RENDER_MODEL=

# Random 32+ character string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RENDER_SIGNING_SECRET=
# Hard daily cap on render spend, in US dollars (default 2)
RENDER_DAILY_CAP_USD=

# Supabase — https://supabase.com/dashboard → your project → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts with sb_secret_). Server only. Never share it.
SUPABASE_SECRET_KEY=

# Stripe (test mode first) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Only for the webhook (optional on your laptop). From the Stripe webhook page or `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Apple in-app purchases (iOS app). Not secrets: the app's bundle id and its numeric "Apple ID"
# from App Store Connect → App Information.
APPLE_BUNDLE_ID=io.scryapp.app
APPLE_APP_ID=
# "yes" counts sandbox purchases (TestFlight, App Review, sandbox testers). They are free, so
# turn it on only while testing or while Apple reviews the app.
APPLE_ALLOW_SANDBOX=

# Optional: the public site address for payment return links, e.g. https://scryle.app
NEXT_PUBLIC_SITE_URL=

# SerpApi (store search) — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# New store searches per day, all visitors together (default 12, a little over the free 250/month plan)
SHOP_SEARCH_DAILY_CAP=

# Only for the live site. Leave empty on your laptop.
# Secret the daily cleanup job (/api/cron/sweep) must send. Random 32+ characters.
CRON_SECRET=
# Comma-separated emails that may open /admin (the account must also be confirmed).
ADMIN_EMAILS=
# Optional affiliate ids for /go links. Empty = links go untagged.
AMAZON_ASSOCIATE_TAG=
SKIMLINKS_PUBLISHER_ID=
